{
  "name": "aj-smart-shift",
  "version": "2.38.8",
  "description": "AJ Smart Shift — نظام إدارة الشيفتات",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:app": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron ."
  },
  "keywords": [],
  "author": "AJ",
  "license": "ISC",
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@fontsource/noto-kufi-arabic": "^5.2.9",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "build": {
    "appId": "com.aj.smartshift",
    "productName": "AJ Smart Shift",
    "copyright": "© 2026 Ahmed Galal — أحمد جلال",
    "publish": [
      {
        "provider": "github",
        "owner": "refaatahmed374-ui",
        "repo": "ajsmartshift-releases",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "AJ-Smart-Shift-Hyper-Setup-v${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AJ Smart Shift",
      "uninstallDisplayName": "AJ Smart Shift v${version}",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025"
    }
  }
}
